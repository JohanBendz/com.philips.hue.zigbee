            "de": "Sensor"
          }
        },
        {
          "name": "duration",
          "type": "number",
          "placeholder": "30",
          "label": {
            "en": "time in seconds",
            "sv": "tid i sekunder",
            "nl": "tijd in seconden",
            "de": "Zeit in Sekunden"
          }
        }
      ]
    },
    "conditions/temperature_above.json": {
      "id": "temperature_above",
      "title": "Temperature is above",
      "titleFormatted": {
        "en": "[[device]] Temperature is !{{above|below}} [[temperature]] degrees",
        "sv": "[[device]] Temperaturen är !{{över|under}} [[temperature]] grader",
