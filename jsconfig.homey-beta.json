{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": [
      "homey",
      "node"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "app.js",
    "drivers/**/*.js",
    "lib/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "test",
    "scripts"
  ]
}
